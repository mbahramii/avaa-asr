      "source": [
        "# ═══════════════════════════════════════════════════════════\n",
        "# Cell 1: Process Kiarash dataset (~20-30 mins)\n",
        "# ═══════════════════════════════════════════════════════════\n",
        "\n",
        "!pip install -q hazm datasets soundfile\n",
        "\n",
        "import os, json, random, time, re, gc\n",
        "import numpy as np, soundfile as sf\n",
        "from datasets import load_dataset\n",
        "from hazm import Normalizer\n",
        "\n",
        "print(\"=\"*70)\n",
        "print(\"📥 Starting dataset processing\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "OUTPUT_DIR = \"/kaggle/working/unified_300h\"\n",
        "AUDIO_DIR = os.path.join(OUTPUT_DIR, \"audio\")\n",
        "TRAIN_MANIFEST = os.path.join(OUTPUT_DIR, \"train_manifest.jsonl\")\n",
        "VAL_MANIFEST = os.path.join(OUTPUT_DIR, \"val_manifest.jsonl\")\n",
        "\n",
        "os.makedirs(AUDIO_DIR, exist_ok=True)\n",
        "\n",
        "import shutil\n",
        "total, used, free = shutil.disk_usage(\"/kaggle/working\")\n",
        "print(f\"💾 Free space: {free / (1024**3):.1f} GB\")\n",
        "\n",
        "normalizer = Normalizer()\n",
        "\n",
        "def clean_text(t):\n",
        "    if not isinstance(t, str): return \"\"\n",
        "    t = re.sub(r\"[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]\", \"\", normalizer.normalize(t))\n",
        "    return re.sub(r\"\\s+\", \" \", t).strip()\n",
        "\n",
        "print(\"\\n🔄 Loading dataset (Streaming Mode)...\")\n",
        "ds = load_dataset(\"kiarashQ/farsi-asr-unified-cleaned\", split=\"train\", streaming=True)\n",
        "\n",
        "manifest = []\n",
        "random.seed(42)\n",
        "t0 = time.time()\n",
        "TARGET = 72000\n",
        "\n",
        "print(f\"🎯 Target: {TARGET} samples\\n\")\n",
        "\n",
        "for i, item in enumerate(ds):\n",
        "    if i >= TARGET: break\n",
        "    try:\n",
        "        # Standard and stable extraction for newer datasets versions\n",
        "        audio = item['audio']\n",
        "        arr = np.array(audio['array'], dtype=np.float32)\n",
        "        sr = audio['sampling_rate']\n",
        "\n",
        "        # Convert stereo to mono if needed\n",
        "        if arr.ndim > 1:\n",
        "            arr = arr.mean(axis=1) if arr.shape[1] <= 2 else arr.mean(axis=0)\n",
        "\n",
        "        text = clean_text(item.get('text', ''))\n",
        "\n",
        "        # Filters\n",
        "        duration = len(arr) / sr\n",
        "        if len(arr) == 0 or len(text) < 3: continue\n",
        "        if duration < 0.5 or duration > 60: continue\n",
        "\n",
        "        # Save audio file\n",
        "        audio_path = os.path.join(AUDIO_DIR, f\"unified_{i:06d}.wav\")\n",
        "        sf.write(audio_path, arr, sr)\n",
        "\n",
        "        manifest.append({\n",
        "            \"audio_filepath\": audio_path,\n",
        "            \"text\": text,\n",
        "            \"duration\": round(duration, 3)\n",
        "        })\n",
        "\n",
        "        if (i+1) % 5000 == 0:\n",
        "            elapsed = time.time() - t0\n",
        "            print(f\"  [{i+1}/{TARGET}] ✅ {len(manifest)} | {(elapsed/60):.1f}m\")\n",
        "\n",
        "        if i > 0 and i % 10000 == 0: gc.collect()\n",
        "    except Exception as e:\n",
        "        if i < 100:  # Only log errors for initial samples\n",
        "            print(f\"  ⚠️ Error at {i}: {e}\")\n",
        "        continue\n",
        "\n",
        "# Train/Val split\n",
        "random.shuffle(manifest)\n",
        "sp = int(len(manifest) * 0.95)\n",
        "\n",
        "with open(TRAIN_MANIFEST, 'w', encoding='utf-8') as f:\n",
        "    for r in manifest[:sp]: f.write(json.dumps(r, ensure_ascii=False) + '\\n')\n",
        "with open(VAL_MANIFEST, 'w', encoding='utf-8') as f:\n",
        "    for r in manifest[sp:]: f.write(json.dumps(r, ensure_ascii=False) + '\\n')\n",
        "\n",
        "print(f\"\\n{'='*70}\")\n",
        "print(f\"✅ Dataset ready: {len(manifest)} samples\")\n",
        "print(f\"📊 Train: {sp} | Val: {len(manifest)-sp}\")\n",
        "print(f\"⏱️ Time elapsed: {(time.time()-t0)/60:.1f} minutes\")\n",
        "\n",
        "total, used, free = shutil.disk_usage(\"/kaggle/working\")\n",
        "print(f\"💾 Used disk space: {used / (1024**3):.1f} GB\")\n",
        "print(f\"{'='*70}\")"
      ]
    }
  ]
}